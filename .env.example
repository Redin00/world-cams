# WorldCams Configuration
# Shodan API Key (leave blank to run in Demo / Educational Mode with preloaded realistic feeds)
SHODAN_API_KEY=
ADMIN_TOKEN=worldcams-admin-2026

# Server Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# MediaMTX Streaming Server Configuration
MEDIAMTX_PATH=./bin/mediamtx
MEDIAMTX_CONFIG=./mediamtx.yml
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_HLS_URL=http://localhost:8888
MEDIAMTX_WHEP_URL=http://localhost:8889
MEDIAMTX_RTSP_PORT=8554

# Database
DATABASE_URL=sqlite+aiosqlite:///./world_cams.db
