# WorldCams Configuration
# Shodan API Key (leave blank to run in Demo / Educational Mode with preloaded realistic feeds)
SHODAN_API_KEY=
ADMIN_TOKEN=worldcams-admin-2026

# Server Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# MediaMTX Streaming Server Configuration
MEDIAMTX_PATH=./bin/mediamtx
MEDIAMTX_CONFIG=./mediamtx.yml
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_HLS_URL=http://localhost:8888
MEDIAMTX_WHEP_URL=http://localhost:8889
MEDIAMTX_RTSP_PORT=8554
# Required on a NATted VPS so WebRTC ICE candidates include your public IP (no external STUN):
# MEDIAMTX_PUBLIC_HOST=your-vps-public-ip-or-domain

# Database
DATABASE_URL=sqlite+aiosqlite:///./world_cams.db

# Optional Tor Anonymizer Proxy (Disabled by default; toggleable in UI)
TOR_ENABLED=false
TOR_AUTO_ROTATE=true
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050
TOR_CONTROL_PORT=9051
TOR_CONTROL_PASSWORD=
